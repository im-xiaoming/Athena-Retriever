ành tây ủng hộ nhau,&lt;br&gt;nên bước &amp;quot;cắt hành&amp;quot; mới là cách hiểu đáng tin (số liệu trong bảng là ví dụ minh hoạ).&lt;br&gt;&lt;br&gt;Lúc train: q của đoạn GT phải chấm câu đúng cao hơn 8217 câu còn lại (L_span);&lt;br&gt;thêm một bản đoạn lệch biên tới 20% để q chịu được biên đoán hơi sai lúc suy luận.&lt;br&gt;Lớp Linear cuối bắt đầu bằng 0, nên ban đầu q chính là trung bình đoạn.&lt;br&gt;&lt;br&gt;omni_proj chủ yếu để thầy dạy q lúc train. Cộng thêm điểm thầy lúc chọn câu không giúp&lt;br&gt;đo được (chênh &amp;lt;= 0.003), nên uniav_api chỉ dùng điểm trong không gian caption." style="text;html=1;fontColor=#f2f2f2;fontSize=14;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1250" y="1319" width="800" height="182" as="geometry"/></mxCell><mxCell id="c147" value="x = Cat(V, A)&lt;br&gt;(B, 1024, T&amp;#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111114;strokeColor=#e6e6e6;fontColor=#f2f2f2;fontSize=13;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="600" y="95" width="180" height="46" as="geometry"/></mxCell><mxCell id="c148" value="Masked Conv 1D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111114;strokeColor=#e6e6e6;fontColor=#f2f2f2;fontSize=14;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="180" height="36" as="geometry"/></mxCell><mxCell id="c149" value="Layer Norm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111114;strokeColor=#e6e6e6;fontColor=#f2f2f2;fontSize=14;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="600" y="258" width="180" height="36" as="geometry"/></mxCell><mxCell id="c150" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#e6e6e6;fontColor=#c4c4cc;fontSize=13;rounded=0;edgeStyle=none;labelBackgroundColor=#33240f;strokeWidth=1.5;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c148" target="c149"><mxGeometry relative="1" as="geometry"><mxPoint