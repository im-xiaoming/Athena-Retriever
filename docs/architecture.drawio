        <mxCell id="c56" value="6 levels per stream: 256, 128, 64, 32, 16, 8 steps (strides 1 to 32), 504 points in all&lt;br&gt;per level &lt;b&gt;Cat(V, A)&lt;/b&gt; -&gt; 1024 channels for the heads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="650" height="52" as="geometry" />
        </mxCell>
