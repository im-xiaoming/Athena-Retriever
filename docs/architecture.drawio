        <mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c42" target="c56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c59" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;- cross-attention: each stream attends over its own steps with the other stream's queries (&lt;code&gt;pyramid_attn: cross&lt;/code&gt;)&lt;br&gt;- every level predicts events of one length range (steps): [0,4] [4,8] [8,16] [16,32] [32,64] [64,inf)&lt;br&gt;- &lt;i&gt;optional&lt;/i&gt; &lt;code&gt;text_stream&lt;/code&gt;: the sentence as a third stream next to V and A (off by default)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="600" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c60" value="Heads (shared over the 6 levels; 2 x (Conv1D + LN + ReLU) + output conv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="885" width="1470" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c61" value="&lt;b&gt;Event head&lt;/b&gt;&lt;br&gt;1 logit per point:&lt;br&gt;is this step inside an event?&lt;br&gt;(class agnostic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c62" value="&lt;b&gt;Boundary head&lt;/b&gt;&lt;br&gt;2 offsets per point (to start / end, x stride)&lt;br&gt;+ 1 IoU-quality logit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="920" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c63" value="&lt;b&gt;Embed head&lt;/b&gt;&lt;br&gt;512-d unit vector per point&lt;br&gt;(+ level-0 raw features 512 x 256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="650" y="920" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c64" value="&lt;b&gt;Ground head&lt;/b&gt;&lt;br&gt;1 logit per (point, sentence)&lt;br&gt;FiLM(sentence) after layer 1&lt;br&gt;+ cos(step vector, sentence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="960" y="920" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c65" value="&lt;b&gt;clip_proj&lt;/b&gt;&lt;br&gt;Linear 512 -&gt; 512&lt;br&gt;text vectors -&gt; event space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1280" y="920" width="210" height="80" as="geometry" />
